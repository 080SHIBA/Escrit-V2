# In dev, leave this unset — vite.config.js proxies /api to your local
# server (see the `server.proxy` block) so a relative "/api" URL works.
#
# In production, the client is on Vercel and the server is on Render,
# which are different origins, so the client needs the server's full
# URL to call it. Set this in Vercel's project environment variables:
# VITE_API_URL=https://your-escrit-server.onrender.com
VITE_API_URL=

# Public Google OAuth Client ID (not secret — this exact value also
# ends up in the compiled client bundle). Powers the "Continue with
# Google" button. Create one at
# https://console.cloud.google.com/apis/credentials and add your dev
# and prod origins under "Authorized JavaScript origins". The local
# default is http://localhost:5173; add 127.0.0.1:5173 too if you browse
# by IP. The same client ID must be set as server GOOGLE_CLIENT_ID.
VITE_GOOGLE_CLIENT_ID=

# Authentication uses the real API by default. Enable only for local UI demos.
VITE_AUTH_MOCKS=false

# Optional local-only mock bank APIs for trying Bank & payouts without a
# running backend. This is ignored in production builds and never verifies
# or saves a real bank account.
VITE_BANK_ACCOUNT_MOCK=false

# Optional local-only sample orders/actions and preview access for /account/orders.
# Enable with true to try the page without a running API. Ignored in production.
VITE_ORDERS_MOCK=false

# Local-only Profile & KYC demo, including private-upload simulation and approval.
# Enabled by default in development; set false to use the API.
VITE_KYC_MOCK=true
VITE_LISTING_MOCK=true

# Local-only resumable onboarding API mock. Enabled by default in development.
VITE_ONBOARDING_MOCK=true

# Optional demo accounts shown as one-click buttons on the login page (for hackathon
# judges). These are compiled into the public bundle: use throwaway accounts only.
VITE_DEMO_BUYER_EMAIL=
VITE_DEMO_BUYER_PASSWORD=
VITE_DEMO_SELLER_EMAIL=
VITE_DEMO_SELLER_PASSWORD=
