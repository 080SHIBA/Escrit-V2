# --- Server ---------------------------------------------------------------
PORT=4000
NODE_ENV=development

# Allowed browser origins, comma-separated. In production list your Vercel
# domain (and preview domain if you use one):
# CLIENT_ORIGIN=https://escrit.vercel.app,https://escrit-git-main-you.vercel.app
CLIENT_ORIGIN=http://localhost:5173

# Public URL of the client, used in emails. Defaults to the first CLIENT_ORIGIN.
CLIENT_URL=http://localhost:5173

# --- Database ---------------------------------------------------------------
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/escrit

# --- Auth -------------------------------------------------------------------
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# --- Payments ---------------------------------------------------------------
# Every provider has a TEST and a LIVE key set. The platform owner switches
# between them at runtime from Admin > Platform settings (no redeploy). A fresh
# deploy always starts in TEST mode. Fill LIVE only when you are ready for real money.
#
# Paystack (default provider)
PAYSTACK_SECRET_KEY_TEST=sk_test_xxx
PAYSTACK_SECRET_KEY_LIVE=
# Paystack signs webhooks with the secret key of the mode that sent the event,
# so these are optional and fall back to the secret keys above.
PAYSTACK_WEBHOOK_SECRET_TEST=
PAYSTACK_WEBHOOK_SECRET_LIVE=
PAYSTACK_BASE_URL=https://api.paystack.co

# Flutterwave (optional alternative provider)
FLW_SECRET_KEY_TEST=
FLW_SECRET_KEY_LIVE=
FLW_SECRET_HASH_TEST=
FLW_SECRET_HASH_LIVE=
FLW_BASE_URL=https://api.flutterwave.com/v3

# Legacy single-key names (PAYSTACK_SECRET_KEY, PAYSTACK_WEBHOOK_SECRET,
# FLW_SECRET_KEY, FLW_SECRET_HASH) are still read as the TEST values.

# --- Escrow -----------------------------------------------------------------
# Payout release requires seller fulfillment and buyer confirmation; there is no payment-time timer.
NO_SHOW_RESPONSE_DAYS=7

# Owner emails bootstrap owner-role accounts at sign-in. Owners can grant admin roles.
OWNER_EMAILS=you@example.com

# Admin emails remain a migration-compatible allowlist for admin access.
ADMIN_EMAILS=you@example.com

# --- Item photos (Cloudinary) -------------------------------------------------
# Find these on the Cloudinary dashboard. Leave blank to disable uploads;
# sellers can still paste an image link.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Google Sign-In (optional) ----------------------------------------------
# Public OAuth Client ID only; there is no client secret. Leave blank to hide the button.
GOOGLE_CLIENT_ID=

# --- Shopify seller channel (optional) --------------------------------------
# Create a Shopify app. Set SHOPIFY_REDIRECT_URI to:
# https://<your-api-host>/api/shopify/callback
# The same exact URL must be an allowed redirect URL in Shopify.
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_REDIRECT_URI=
# Generate a private 32-byte key (hex is 64 characters) and keep it server-only.
SHOPIFY_TOKEN_ENCRYPTION_KEY=
SHOPIFY_API_VERSION=2026-10

# --- Email (Brevo) ----------------------------------------------------------
# Required for new email/password sign-ups (verification links are never logged).
# Without these, sign-up is disabled; legacy OTP/reset flows use a local log fallback.
BREVO_API_KEY=
BREVO_FROM_ADDRESS=
BREVO_FROM_NAME=Escrit
